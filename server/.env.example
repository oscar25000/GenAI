# Trello API key — obtenue sur https://trello.com/app-key
# La clé n'est PAS un secret côté Trello : elle identifie l'application.
TRELLO_API_KEY=

# Port d'écoute du serveur
PORT=3001

# Origines autorisées par CORS (séparées par des virgules).
# - chrome-extension://<ton-extension-id> en prod
# - http://localhost:5173 pour le mode npm run dev (vite)
ALLOWED_ORIGINS=http://localhost:5173
